<?xml version="1.0" encoding="utf-8"?>
<!--
T027.1 - Windows x64 Publish Profile

This profile configures the Windows Bridge service for deployment as a
self-contained Windows executable. The output is a single .exe file that
includes the .NET runtime and all dependencies.

Usage:
  dotnet publish -p:PublishProfile=win-x64

Or use the publish script:
  .\scripts\publish.ps1
-->
<Project>
  <PropertyGroup>
    <!-- Publish settings -->
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>

    <!-- Target runtime -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TargetFramework>net8.0</TargetFramework>

    <!-- Self-contained deployment -->
    <SelfContained>true</SelfContained>

    <!-- Single file output -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Performance optimizations -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Do not trim - COM interop may break -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Debug symbols -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
</Project>
