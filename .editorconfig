# EditorConfig helps maintain consistent coding styles across editors
# https://editorconfig.org

root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Python files
[*.py]
indent_size = 4
max_line_length = 88

# TypeScript and JavaScript files
[*.{ts,tsx,js,jsx}]
indent_size = 2

# C# files
[*.cs]
indent_size = 4

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab

# PowerShell scripts
[*.ps1]
indent_size = 4
end_of_line = crlf

# Batch scripts
[*.{bat,cmd}]
end_of_line = crlf
