# ContPAQ-Win AI Service - Environment Configuration
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.

# ===================
# Server Settings
# ===================

# Server host address
# Default: 127.0.0.1 (localhost only - recommended for security)
# Use 0.0.0.0 only for development when network access is needed
HOST=127.0.0.1

# Server port number
# Default: 8000 (standard FastAPI/Uvicorn port)
PORT=8000

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO (recommended for production)
LOG_LEVEL=INFO

# ===================
# Service Paths
# ===================

# Path to Tesseract OCR executable
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
# Mac (Homebrew): /usr/local/bin/tesseract
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Path to LayoutLMv3 model directory
# Can be relative (to ai-service root) or absolute
# Default: ./models/layoutlm
MODEL_PATH=./models/layoutlm
